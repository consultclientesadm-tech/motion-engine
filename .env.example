# Infra
DATABASE_URL=postgresql://motion:motion@db:5432/motion
REDIS_URL=redis://redis:6379/0
S3_ENDPOINT=http://minio:9000        # R2: https://<conta>.r2.cloudflarestorage.com | AWS: deixe vazio
S3_BUCKET=motion-engine
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio12345
S3_REGION=auto
S3_TMP_RETENTION_DAYS=7

# Dinheiro
GPU_USD_PER_HOUR=1.2                 # Vast.ai A100
DAILY_BUDGET_USD=90                  # teto diário do servidor (o do request nunca passa disso)
MAX_JOB_BUDGET_USD=200

# Render
BLOCK_SECONDS=30
FPS=30
DEVICE=cuda

# Calibração do custo (GPU-segundos por frame). Veja README.
# COST_DETECT_S=0.012
# COST_POSE_S=0.008
# COST_RENDER_S_BASE=0.15
# COST_RENDER_S_PERSON=0.10
# COST_LIPSYNC_S=0.03
# COST_UPSCALE_S=0.18
# COST_AVATAR_S=60
